FORKLIFT_PUBLIC_URL=http://localhost:8080
FORKLIFT_BIND=127.0.0.1
FORKLIFT_PORT=8080
# Choose a random one-time setup key with your password manager (32+ characters).
# If blank, the initializer generates one and displays it in its local container log.
FORKLIFT_BOOTSTRAP_TOKEN=
# The primary's private directory address/port is selected in Forklift's setup wizard.

# Authoritative DNS only; choose another port/IP if another service uses 53.
FORKLIFT_DNS_BIND=127.0.0.1
FORKLIFT_DNS_PORT=53

# Images are pulled from ghcr.io/galgathor and default to latest.
# Optional: pin a specific published build instead of latest.
# FORKLIFT_IMAGE_TAG=sha-FULL_COMMIT_SHA

FORKLIFT_PUBLIC_URL=http://localhost:8080
FORKLIFT_BIND=127.0.0.1
FORKLIFT_PORT=8080
# Choose a random one-time setup key with your password manager (32+ characters).
# If blank, the initializer generates one and displays it in its local container log.
FORKLIFT_BOOTSTRAP_TOKEN=
# The primary's private directory address/port is selected in Forklift's setup wizard.

# DNS listener; choose another port/IP if another service uses 53.
# Listen on host interfaces so other machines and replicas can reach DNS.
# Limit access to your private network with your host firewall.
# Optional: bind Docker to the Forklift host’s registered private address.
# FORKLIFT_DNS_BIND=192.168.1.2
FORKLIFT_DNS_PORT=53

# Optional LAN discovery publisher; clients can always use a manual HTTPS URL.
# Enable the discovery Compose profile only after configuring verified WebUI HTTPS.
# The default bundle includes the Docker host's trusted public/private CAs.
FORKLIFT_DISCOVERY_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
